{
  "name": "workspace",
  "private": true,
  "workspaces": [
    "contracts",
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace @workspace/contracts",
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run build:contracts && npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "build:backend": "npm run build:contracts && npm run build --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "format": "npm run format --workspace frontend",
    "check": "npm run check --workspace frontend",
    "fix": "npm run fix --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:backend": "npm run build:contracts && npm run test --workspace backend"
  }
}
