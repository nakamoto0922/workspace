{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @workspace/contracts",
    "prebuild": "npm run build --workspace @workspace/contracts",
    "pretypecheck": "npm run build --workspace @workspace/contracts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "db:baseline": "tsx src/db/baseline.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@workspace/contracts": "*",
    "@hono/node-server": "^1.19.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
